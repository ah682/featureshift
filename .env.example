# Optional local settings. No API keys are required or read.
FEATURESHIFT_HOST=127.0.0.1
FEATURESHIFT_PORT=8765
# Runtime state may be relocated; worker environments remain project-local.
# FEATURESHIFT_STATE=/absolute/path/to/local/state
# This release has no live model provider. Rules use zero model calls.
FEATURESHIFT_PROVIDER=deterministic-rules

